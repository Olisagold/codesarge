# Codeverity API. Use a test key (sk_test_...) while developing: results are
# simulated and don't spend model credit.
CODEVERITY_API_URL=http://localhost:8000
CODEVERITY_API_KEY=

# Signing secret from the webhook endpoint you add in the Codeverity dashboard.
# Point the endpoint at http://<this host>:4000/api/webhooks/codeverity.
CODEVERITY_WEBHOOK_SECRET=

# SQLite file, created on first run.
DATABASE_PATH=data/codesarge.db

# Admin account created the first time the database is set up.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
